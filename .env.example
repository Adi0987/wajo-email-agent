# Wajo works with any OpenAI-compatible chat API. Copy this file to .env and fill in your provider's values.
# Examples (pick one):
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1         LLM_MODEL=gpt-4o-mini
#   Anthropic:  LLM_BASE_URL=https://api.anthropic.com/v1      LLM_MODEL=claude-sonnet-4-6
#   DeepSeek:   LLM_BASE_URL=https://api.deepseek.com          LLM_MODEL=deepseek-chat
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1         LLM_MODEL=llama3.1   (any non-empty key)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
